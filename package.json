{
  "name": "sshnesh",
  "version": "0.4.2",
  "description": "Desktop SSH client with explicit MCP session sharing",
  "main": "src/main.cjs",
  "scripts": {
    "test": "node --test test/access.test.cjs",
    "test:sync": "node --test test/sync.test.cjs",
    "build": "node scripts/build.cjs",
    "start": "npm run build && electron .",
    "test:e2e": "node test/e2e.cjs",
    "dist:win": "npm run build -- --win && electron-builder --win zip --x64",
    "dist:linux": "npm run build && electron-builder --linux AppImage"
  },
  "keywords": [],
  "author": "SSHnesh",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/xterm": "6.0.0",
    "ssh2": "1.17.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "electron": "45.3.2",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "playwright": "1.65.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Xelopat/SSHnesh.git"
  }
}
