{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SSHnesh Preview",
  "version": "0.1.2",
  "identifier": "ru.xelopat.sshnesh.preview",
  "build": {
    "beforeBuildCommand": "node prototype/build.cjs",
    "beforeDevCommand": "node prototype/build.cjs",
    "frontendDist": "web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "label": "main", "title": "SSHnesh Preview", "width": 1100, "height": 720 }],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.png", "icons/icon.ico"]
  },
  "plugins": {
    "deep-link": {
      "mobile": [{ "scheme": ["ru.xelopat.sshnesh.preview"], "host": "auth", "path": ["/callback"], "appLink": false }]
    }
  }
}
